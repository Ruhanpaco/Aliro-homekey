# Overlay that turns this firmware into a Matter door lock, on top of
# sdkconfig.defaults. Build with:
#
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.matter" build
#
# inside the espressif/esp-matter container (or with ESP_MATTER_PATH exported),
# which is what .github/workflows/matter-firmware.yml does.

CONFIG_ALIRO_MATTER_ENABLE=y

# --- Commissioning ---------------------------------------------------------
# A device that is not on the network yet can only be reached over BLE, so
# BLE is how commissioning starts even though the lock then lives on Wi-Fi.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Nothing on this device is a BLE client or scanner. Dropping the roles it
# does not use is ~30 KB.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# --- Wi-Fi -----------------------------------------------------------------
# ENABLE_WIFI_AP is chip's own access point, which this project does not use.
# The IDF SoftAP driver stays on: net_manager raises the setup portal with it,
# and that portal is the only way to configure a board that has never been
# commissioned.
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Matter is IPv6 end to end, including on Wi-Fi. One link-local address plus
# one unique local address per fabric.
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# --- What we do not need from esp-matter -----------------------------------
# This firmware already has an OTA page, a serial console and a web UI, so the
# Matter equivalents are all cost and no benefit.
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_CHIP_ENABLE_BDX_LOG_TRANSFER=n
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n

# One endpoint: the door lock. (Endpoint 0 is the root node and does not
# count against this.)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=1
CONFIG_ESP_MATTER_NVS_USE_COMPACT_ATTR_STORAGE=y

# --- Crypto ----------------------------------------------------------------
# sdkconfig.defaults turns the long SHA variants off because the Aliro
# transaction is SHA-256 throughout. The Matter SDK's crypto layer is not, so
# they come back for this build.
CONFIG_MBEDTLS_SHA384_C=y
CONFIG_MBEDTLS_SHA512_C=y
CONFIG_MBEDTLS_HKDF_C=y

# --- Fitting in the image --------------------------------------------------
# Measured on the ESP32: without these the link overflows IRAM by ~5.7 KB, and
# the application does not fit a 1.875 MB OTA slot.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_FLASH_ROM_IMPL=y

# The Matter task and the event task both run deeper stacks than an IDF
# application usually needs.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# Deeper than esp-matter's own examples need, because commands land on this
# task and two of ours are expensive: SetCredential parses a PEM and derives a
# key slot (mbedTLS parse plus a PSA import), and SetAliroReaderConfig converts
# two keys and then rebuilds the reader, which parses them again. This project
# has already been bitten once by that path -- on a short stack it does not
# crash, it fails soft with ESP_FAIL, which reads exactly like a malformed key.
CONFIG_CHIP_TASK_STACK_SIZE=10240
