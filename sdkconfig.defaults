# Common defaults for every board. Board-specific overrides live in boards/.
# Build with:
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/sdkconfig.defaults.<board>" build

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# partitions.csv carries two 1.875 MB OTA slots, which needs more than the 2 MB
# the build assumes by default. 4 MB is what an ESP32-WROOM-32 DevKitC and an
# ESP32-S3 DevKit actually have. A 2 MB board needs a smaller partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Required by esp_aliro_lib -------------------------------------------
# The Aliro transaction is ECDH/ECDSA on P-256, AES-GCM and HKDF-SHA256.
# Reader and credential keys are parsed from PEM.
CONFIG_MBEDTLS_PEM_PARSE_C=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECP_NIST_OPTIM=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_PK_PARSE_EC_EXTENDED=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_SHA1_C=y
CONFIG_MBEDTLS_HKDF_C=y

# --- Code size -----------------------------------------------------------
CONFIG_MBEDTLS_FS_IO=n
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_HAVE_TIME=n
CONFIG_MBEDTLS_SELF_TEST=n
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_SHA384_C=n
CONFIG_MBEDTLS_SHA512_C=n

# --- Configuration web service -------------------------------------------
# The UI is one embedded HTML file; the API is JSON over esp_http_server.
# WebSocket support is off by default in ESP-IDF, and web_server.c registers a
# websocket route unconditionally (httpd_uri_t.is_websocket only exists when
# this is on). Set here rather than redeclared in a Kconfig of ours, which
# would shadow the esp_http_server symbol.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- Logging -------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
