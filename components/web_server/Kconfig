menu "Web Server"

config HTTPD_WS_SUPPORT
    bool "Enable WebSocket support"
    default y
    help
        Enable WebSocket support in HTTP server for real-time updates.

config ALIRO_WS_MAX_CLIENTS
    int "Maximum WebSocket clients"
    default 4
    range 1 16
    help
        Maximum number of simultaneous WebSocket connections.

config ALIRO_OTA_MAX_SIZE
    int "Maximum OTA firmware size (bytes)"
    default 2097152
    help
        Maximum size allowed for firmware OTA updates (default 2MB).

endmenu
